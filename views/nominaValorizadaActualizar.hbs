<div class="container mt-4">
  <div class="row justify-content-center">
    <div class="col-12 col-md-6 col-lg-5">
      <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
          <h5 class="mb-0">Actualizar nómina valorizada</h5>
        </div>
        <form action="/nominaValorizada/actualizarNomina" method="POST">
          <input type="hidden" name="idNomina" value="{{idNomina}}">
          <div class="card-body">
            <div class="mb-3">
              <label for="porcentajeActualizacion" class="form-label">Porcentaje de actualización</label>
              <div class="input-group">
                <input type="number" class="form-control" id="porcentajeActualizacion" name="porcentajeActualizacion" placeholder="0" step="0.01" required>
                <span class="input-group-text">%</span>
              </div>
              <div class="form-text">Indicá el porcentaje de ajuste que querés aplicar sobre los valores vigentes.</div>
            </div>
            <div class="row g-3">
              <div class="col-sm-6">
                <label for="vigenciaDesde" class="form-label">Vigencia desde</label>
                <input type="date" class="form-control" id="vigenciaDesde" name="vigenciaDesde" value="{{vigenciaDesde}}">
              </div>
              <div class="col-sm-6">
                <label for="vigenciaHasta" class="form-label">Vigencia hasta</label>
                <input type="date" class="form-control" id="vigenciaHasta" name="vigenciaHasta" value="{{vigenciaHasta}}">
              </div>
            </div>
            <div class="form-text mt-2">Podés ajustar las fechas de vigencia antes de aplicar el porcentaje.</div>
          </div>
          <div class="card-footer d-flex justify-content-end gap-2">
            <a class="btn btn-outline-secondary" href="/nominaValorizada">Cancelar</a>
            <button type="submit" class="btn btn-primary">Aceptar</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
